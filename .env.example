NODE_ENV=production
PORT=3001
CHALLENGES_DB_PATH=./data/challenges.sqlite
CHALLENGES_DB_BACKUP_DIR=./data/backups
OPENAI_API_KEY=
OPENAI_MODEL=
LEETCODE_AUTHORIZATION=
LEETCODE_COOKIE=
LEETCODE_CSRF_TOKEN=
LEETCODE_USER_AGENT=
VITE_API_BASE_URL=
# Production API boundary
SITE_AUTH_USER=personal
SITE_AUTH_TOKEN=replace-with-a-long-random-token
CORS_ORIGIN=https://your-personal-domain.example
REQUEST_BODY_LIMIT=512kb
MUTATION_RATE_LIMIT=60

# Execution isolation
EXECUTION_BACKEND=docker
SANDBOX_IMAGE=problem-set-runner:local
