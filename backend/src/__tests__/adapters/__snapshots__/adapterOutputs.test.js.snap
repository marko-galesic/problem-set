      ],
    ],
  },
  "inputHelpers": "function getTestBoard(index) {
  const grids = [[["5","3",".",".","7",".",".",".","."],["6",".",".","1","9","5",".",".","."],[".","9","8",".",".",".",".","6","."],["8",".",".",".","6",".",".",".","3"],["4",".",".","8",".","3",".",".","1"],["7",".",".",".","2",".",".",".","6"],[".","6",".",".",".",".","2","8","."],[".",".",".","4","1","9",".",".","5"],[".",".",".",".","8",".",".","7","9"]]];
  const grid = grids[index] || [];
  return grid.map(row => row.slice());
}",
  "invocation": "const board = getTestBoard(i);
          actual = solver.solveSudoku(board);",
  "name": "sudokuSolver",
  "returnType": "string[][]",
  "serializer": "function serializeCharMatrix(matrix) {
  if (matrix === null || matrix === undefined) return "null";
  if (!Array.isArray(matrix)) return "null";
  if (matrix.length === 0) return "[]";
  const rows = matrix.map((row) => {
    if (!Array.isArray(row)) return "null";
    const cells = row.map((cell) => "'" + escapeChar(cell ?? '') + "'");
    return "[" + cells.join(", ") + "]";
  });
  return "[" + rows.join(", ") + "]";
}

function escapeChar(value) {
  return String(value)
    .replace(/\\\\/g, "\\\\\\\\")
    .replace(/'/g, "\\\\'")
    .replace(/\\n/g, "\\\\n")
    .replace(/\\r/g, "\\\\r")
    .replace(/\\t/g, "\\\\t");
}",
  "serializerMethod": "serializeCharMatrix",
  "testCaseFile": "sudokuSolverTests.js",
}
`;

