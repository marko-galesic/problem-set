  "name": "maximumAverageSubarrayI",
  "returnType": "double",
  "serializer": "    // Serialize a double to a canonical string representation
    private static String serializeDouble(double value) {
        if (Double.isNaN(value) || Double.isInfinite(value)) {
            return String.valueOf(value);
        }
        double rounded = Math.round(value * 100000.0) / 100000.0;
        return String.format(java.util.Locale.US, "%.5f", rounded);
    }",
  "serializerMethod": "serializeDouble",
  "testCaseFile": "maximumAverageSubarrayITests.js",
}
