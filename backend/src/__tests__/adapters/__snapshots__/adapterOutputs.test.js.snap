exports[`adapter outputs (characterization) python adapters groupAnagrams 1`] = `
{
  "adapterPath": "./adapters/python/groupAnagramsAdapter.js",
  "defaultClassName": "GroupAnagrams",
  "expectedCode": "    expected = [["bat"], ["nat", "tan"], ["ate", "eat", "tea"]]
",
  "extractInput": {
    "strs": [
      "eat",
      "tea",
      "tan",
      "ate",
      "nat",
      "bat",
    ],
  },
  "inputHelpers": "def get_test_strs(index):
    inputs = [
        ["eat", "tea", "tan", "ate", "nat", "bat"]
    ]
    return inputs[index]
",
  "invocation": "strs = get_test_strs(i)
actual = solver.groupAnagrams(strs)",
  "name": "groupAnagrams",
  "returnType": "list[list[str]]",
  "serializer": "def normalize_group_anagrams(matrix):
    if not isinstance(matrix, list):
        return None
    normalized = []
    for row in matrix:
        if not isinstance(row, list):
            normalized.append(None)
            continue
        items = [None if value is None else str(value) for value in row]
        items.sort(key=lambda value: (value is not None, value or ""))
        normalized.append(items)

    def group_key(group):
        if group is None:
            return (0, ())
        return (1, tuple((0, "") if value is None else (1, value) for value in group))

    normalized.sort(key=group_key)
    return normalized


def serialize_group_anagrams(matrix):
    if matrix is None:
        return "null"
    if not isinstance(matrix, list):
        return "null"
    if len(matrix) == 0:
        return "[]"

    import json
    normalized = normalize_group_anagrams(matrix)
    rows = []
    for row in normalized:
        if row is None:
            rows.append("null")
            continue
        items = []
        for value in row:
            if value is None:
                items.append("null")
            else:
                items.append(json.dumps(str(value)))
        rows.append("[" + ", ".join(items) + "]")
    return "[" + ", ".join(rows) + "]"
",
  "serializerMethod": "serialize_group_anagrams",
  "testCaseFile": "groupAnagramsTests.js",
}
`;

