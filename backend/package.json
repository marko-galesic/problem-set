    "sharp": "^0.33.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@jest/test-sequencer": "^29.7.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
