{
  "name": "problem-set-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "backup:db": "node src/db/backupDatabase.js",
    "backfill:challenge-metadata": "node src/db/backfillChallengeMetadata.js",
    "backfill:leetcode": "node src/db/backfillLeetCodeSubmissions.js",
    "backfill:testcases": "node src/db/backfillTestCasesFromFiles.js",
    "seed:challenge-content": "node src/db/seedChallengeContent.js",
    "migrate": "node src/db/migrate.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:gold": "NODE_OPTIONS=--experimental-vm-modules jest goldSource.test.js",
